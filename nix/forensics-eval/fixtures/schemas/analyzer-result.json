{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/forensics-eval/analyzer-result.schema.json",
  "title": "Forensics analyzer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "analyzer",
    "stage",
    "status",
    "summary",
    "findings",
    "evidence",
    "metrics"
  ],
  "properties": {
    "contractVersion": { "type": "string" },
    "analyzer": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["clean", "finding", "skipped", "error"]
    },
    "summary": { "type": "object" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "classification",
          "description",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/evidence"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence" }
    },
    "metrics": { "type": "object" }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "detail"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "snippet": { "type": "string" },
        "sha256": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
