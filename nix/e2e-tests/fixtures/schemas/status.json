{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/e2e/fixtures/status.schema.json",
  "title": "NAILS status --json",
  "description": "Machine-readable status envelope: one document with schema_version, command, ok, and either data (success) or error (pre-dispatch failure).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "status" },
    "ok": { "type": "boolean" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "state_source",
        "posture",
        "overlays",
        "remaining_mounts",
        "overlay_verification",
        "opsec_reminders"
      ],
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "inactive",
                "activating",
                "active",
                "deactivating",
                "degraded",
                "unknown"
              ]
            },
            "reason": { "type": "string", "minLength": 1 },
            "remaining_mounts": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "state_source": {
          "type": "string",
          "enum": ["loaded", "missing", "unreadable", "corrupt"]
        },
        "posture": {
          "type": "string",
          "enum": ["decoy", "active", "degraded", "inconsistent", "unknown"]
        },
        "remediation": { "type": "string", "minLength": 1 },
        "remaining_mounts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" }
        },
        "persona_mode": {
          "type": "string",
          "enum": ["shared-home", "fresh-home"]
        },
        "activated_at": { "type": "string", "format": "date-time" },
        "uptime_seconds": { "type": "integer", "minimum": 0 },
        "uptime_formatted": { "type": "string", "minLength": 1 },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mount_point", "status", "owned"],
            "properties": {
              "mount_point": { "type": "string", "pattern": "^/" },
              "status": {
                "type": "string",
                "enum": ["mounted", "not_mounted"]
              },
              "owned": { "type": "boolean" },
              "upperdir": { "type": "string", "pattern": "^/" }
            }
          }
        },
        "overlay_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["verified", "mismatch", "skipped", "not_applicable"]
            },
            "errors": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "nixos_generation": { "type": "string", "minLength": 1 },
        "hidden_root_total_bytes": { "type": "integer", "minimum": 0 },
        "hidden_root_used_bytes": { "type": "integer", "minimum": 0 },
        "hidden_root_available_bytes": { "type": "integer", "minimum": 0 },
        "opsec_reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "message"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["info", "warning", "critical"]
              },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      }
    }
  }
}
