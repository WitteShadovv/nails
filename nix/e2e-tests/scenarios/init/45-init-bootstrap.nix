# Scenario `init-bootstrap` of the `init-config` batch:
#   tests/init/45-init-config.nix
# Formerly the stand-alone test
#   tests/init/45-init-bootstrap.nix
# It now shares one VM boot with the batch's other scenarios (lib/batch.nix);
# its subtests and assertions are unchanged.
#
# Test 45: Init Bootstrap

_:
let
  hiddenVolume = import ./../../lib/hidden-volume.nix;
in
{
  name = "init-bootstrap";
  tags = [
    "init"
    "smoke"
  ];

  helpers = [
  ];

  script = ''
    def scenario_init_bootstrap() -> None:
        machine.wait_for_unit("multi-user.target")

        expected_dirs = [
            "/mnt/data/logs",
            "/mnt/data/config",
            "/mnt/data/config/nixos",
            "/mnt/data/etc",
            "/mnt/data/etc/nixos",
            "/mnt/data/etc/nixos/nails",
            "/mnt/data/home",
            "/mnt/data/nix",
            "/mnt/data/.work",
            "/mnt/data/.work/etc",
            "/mnt/data/.work/home",
            "/mnt/data/.work/nix",
        ]

        expected_files = {
            "/mnt/data/config/nails.toml": "600",
            "/mnt/data/state.json": "600",
            "/mnt/data/config/nixos/configuration.nix": "600",
            "/mnt/data/etc/nixos/hardware-configuration.nix": "600",
        }

        with subtest("prepare bare hidden volume"):
            machine.succeed("""${hiddenVolume.setupHiddenVolume}""")
            machine.succeed("bash -lc 'shopt -s dotglob nullglob && rm -rf /mnt/data/*'")
            machine.succeed("test -z \"$(ls -A /mnt/data)\"")
            machine.succeed("mkdir -p /tmp/init-bootstrap-etc-nixos")
            machine.succeed(
                """cat > /tmp/init-bootstrap-etc-nixos/hardware-configuration.nix <<'EOF'
    { config, lib, pkgs, modulesPath, ... }:
    {
      imports = [ (modulesPath + \"/installer/scan/not-detected.nix\") ];
    }
    EOF"""
            )
            machine.succeed("mount --bind /tmp/init-bootstrap-etc-nixos /etc/nixos")

        with subtest("run init bootstrap"):
            init_output = machine.succeed("nails init /mnt/data")
            assert "Next steps:" in init_output, init_output
            assert "nails activate" in init_output, init_output

        with subtest("assert directory skeleton and permissions"):
            for path in expected_dirs:
                machine.succeed(f"test -d {path}")
                perms = machine.succeed(f"stat -c %a {path}").strip()
                assert perms == "700", f"Expected 0700 on {path}, got {perms}"
            machine.fail("test -e /mnt/data/state")
            machine.fail("test -e /mnt/data/overlays")

        with subtest("assert generated files and symlink staging"):
            for path, expected_perm in expected_files.items():
                machine.succeed(f"test -f {path}")
                perms = machine.succeed(f"stat -c %a {path}").strip()
                assert perms == expected_perm, f"Expected {expected_perm} on {path}, got {perms}"

            machine.succeed("test -L /mnt/data/etc/nixos/nails/configuration.nix")
            target = machine.succeed("readlink /mnt/data/etc/nixos/nails/configuration.nix").strip()
            assert target == "/mnt/data/config/nixos/configuration.nix", target

        with subtest("assert generated config content"):
            config_text = machine.succeed("cat /mnt/data/config/nails.toml")
            assert "generated by `nails init`" in config_text, config_text
            # The root stays commented out so it is derived from the binary location.
            assert '# hidden_volume_root = "/mnt/data"' in config_text, config_text
            assert not any(line.startswith("hidden_volume_root") for line in config_text.splitlines()), config_text
            validation = machine.succeed("nails config validate /mnt/data/config/nails.toml")
            assert "valid" in validation, validation

            hardware_text = machine.succeed("cat /mnt/data/etc/nixos/hardware-configuration.nix")
            assert "./nails/configuration.nix" in hardware_text, hardware_text

            hidden_config = machine.succeed("cat /mnt/data/config/nixos/configuration.nix")
            assert "Hidden-session configuration" in hidden_config, hidden_config
            # The seed is a commented template: it must parse but enable nothing.
            machine.succeed("nix-instantiate --parse /mnt/data/config/nixos/configuration.nix")

            state_json = machine.succeed("cat /mnt/data/state.json")
            assert '"state": "Inactive"' in state_json, state_json
  '';
}
