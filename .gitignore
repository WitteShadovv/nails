# NAILS - Generated files and directories
# These files are created during NAILS operations and should not be tracked

# State and runtime files
.nails-state

# Overlay filesystem structures
overlay/
work/

# Configuration files (created by init command)
config/configuration.nix
config/hardware-configuration.nix

# Safety backups (contain system files that shouldn't be in git)
safety/

# Manual backups directory
backups/

# Build artifacts
build/
dist/
*.egg-info/
*.spec

# Temporary union filesystem mount points (if they exist in workspace)
/tmp/nails-union/

# Log files (if any are generated)
*.log
nails.log

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments (if used for development)
venv/
env/
.env

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS generated files
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Nix build results (if building locally)
result
result-*

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Test artifacts
.coverage
htmlcov/
.pytest_cache/
.tox/

# MyPy cache
.mypy_cache/
.dmypy.json
dmypy.json
