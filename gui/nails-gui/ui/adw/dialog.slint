// A question over the window, as libadwaita's alert dialog: a heading, the
// sentence it asks about, Cancel and the action it confirms. A question that
// asks for a word to be typed first (allowing a risk is never one click) has
// a field for it, and its confirming button acts only once the word is there.
// A question with a second action (a deactivation's two endings) stacks its
// three buttons, as libadwaita does when they do not fit side by side: the
// confirming one, the second action, and Cancel at the bottom. Cancel and
// the confirming button stack the same way where a label does not fit half
// the dialog's width, at the window's narrowest or for a long label.
//
// It holds the keyboard while it is open. Focus starts on Cancel, or in the
// field when there is one; Tab and Shift+Tab move between its controls,
// because every control behind it is unreachable while it is open (the
// window passes that down); Escape cancels from anywhere in it; Return
// presses only the button that has the focus, so it never confirms by
// itself. The pointer cannot reach the window behind it either. One control
// is not behind it: in a hidden session the window's Emergency control lies
// above it, and Tab and the pointer reach it as well.

import { Adw } from "theme.slint";
import { Button, ButtonKind, ButtonShape } from "button.slint";
import { WordEntry } from "entry.slint";

export component AlertDialog {
    in property <string> heading;
    in property <string> body;
    in property <string> confirm-label;
    in property <bool> destructive;
    // The prompt of the word to type first; empty when there is none.
    in property <string> prompt;
    // The confirming button waits for that word.
    in property <bool> locked;
    // The label of the second action; empty when there is none.
    in property <string> alternative;
    // Called with true for the confirming button, false for Cancel or Escape.
    callback answered(confirmed: bool);
    // Called for the second action.
    callback alternative-chosen();
    // Called with what is in the field each time it changes.
    callback typed(text: string);

    accessible-role: groupbox;
    accessible-label: root.heading;
    accessible-description: root.body;

    // The widest label of the two buttons, measured as a button draws it,
    // against the half of the dialog each would get side by side.
    confirm-measure := Text {
        text: root.confirm-label;
        font-weight: Adw.weight-bold;
        visible: false;
        accessible-role: none;
    }
    cancel-measure := Text {
        text: "Cancel";
        font-weight: Adw.weight-bold;
        visible: false;
        accessible-role: none;
    }
    property <length> label-room: (sheet.width - 2 * 24px - 12px) / 2 - 2 * 20px;
    property <bool> stacked: max(confirm-measure.preferred-width, cancel-measure.preferred-width) > root.label-room;

    // The dimming over the window, and nothing underneath gets the pointer.
    Rectangle {
        background: Adw.dimming;
    }

    TouchArea { }

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.answered(false);
                return accept;
            }
            reject
        }

        sheet := Rectangle {
            width: min(root.width - 24px, 372px);
            height: content.preferred-height;
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height - self.height) / 2px) * 1px;
            border-radius: Adw.alert-radius;
            background: Adw.dialog-bg;
            border-width: 1px;
            border-color: Adw.outline;

            content := VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 32px;
                padding-bottom: 24px;
                spacing: 10px;

                Text {
                    text: root.heading;
                    font-size: Adw.font-size-title;
                    font-weight: Adw.weight-title;
                    color: Adw.dialog-fg;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-role: none;
                }

                Text {
                    text: root.body;
                    color: Adw.dialog-fg;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-role: none;
                }

                if root.prompt != "": WordEntry {
                    prompt: root.prompt;
                    edited(text) => {
                        root.typed(text);
                    }
                }

                if root.alternative == "" && !root.stacked: HorizontalLayout {
                    padding-top: 22px;
                    spacing: 12px;

                    Button {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        text: "Cancel";
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        // The field takes the focus itself when there is one.
                        init => {
                            if (root.prompt == "") {
                                self.focus();
                            }
                        }
                        clicked => {
                            root.answered(false);
                        }
                    }

                    Button {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        text: root.confirm-label;
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        kind: root.destructive ? ButtonKind.destructive : ButtonKind.suggested;
                        enabled: !root.locked;
                        clicked => {
                            root.answered(true);
                        }
                    }
                }

                if root.alternative == "" && root.stacked: VerticalLayout {
                    padding-top: 22px;
                    spacing: 12px;

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: root.confirm-label;
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        kind: root.destructive ? ButtonKind.destructive : ButtonKind.suggested;
                        enabled: !root.locked;
                        clicked => {
                            root.answered(true);
                        }
                    }

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: "Cancel";
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        init => {
                            if (root.prompt == "") {
                                self.focus();
                            }
                        }
                        clicked => {
                            root.answered(false);
                        }
                    }
                }

                if root.alternative != "": VerticalLayout {
                    padding-top: 22px;
                    spacing: 12px;

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: root.confirm-label;
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        kind: root.destructive ? ButtonKind.destructive : ButtonKind.suggested;
                        enabled: !root.locked;
                        clicked => {
                            root.answered(true);
                        }
                    }

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: root.alternative;
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        clicked => {
                            root.alternative-chosen();
                        }
                    }

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: "Cancel";
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        init => {
                            self.focus();
                        }
                        clicked => {
                            root.answered(false);
                        }
                    }
                }
            }
        }
    }
}
