// A question over the window, as libadwaita's alert dialog: a heading, the
// sentence it asks about, Cancel and the action it confirms. A question that
// asks for a word to be typed first (allowing a risk is never one click) has
// a field for it, and its confirming button acts only once the word is there.
// A question with a second action (a deactivation's two endings) stacks its
// three buttons, as libadwaita does when they do not fit side by side: the
// confirming one, the second action, and Cancel at the bottom. Cancel and
// the confirming button stack the same way where a label does not fit half
// the dialog's width, at the window's narrowest or for a long label.
//
// It is never taller than the window. A sentence longer than the room left
// between the heading and the answers scrolls there, with the wheel, a drag
// or, from its buttons, the arrow and page keys (a field keeps those keys for
// its cursor), and a bar at its edge shows where the view lies in it; the
// heading, the field and the answers stay in view.
//
// It holds the keyboard while it is open. Focus starts on Cancel, or in the
// field when there is one, and stays where it is when the answers change
// between side by side and stacked as the window is resized. Tab and
// Shift+Tab move between its controls, because every control behind it is
// unreachable while it is open (the window passes that down); Escape
// cancels from anywhere in it; Return presses only the button that has the
// focus, so it never confirms by itself. The pointer cannot reach the window
// behind it either. One control is not behind it: in a hidden session the
// window's Emergency control lies above it, and Tab and the pointer reach it
// as well.

import { Adw } from "theme.slint";
import { Button, ButtonKind, ButtonShape } from "button.slint";
import { WordEntry } from "entry.slint";

export component AlertDialog {
    in property <string> heading;
    in property <string> body;
    in property <string> confirm-label;
    in property <bool> destructive;
    // The prompt of the word to type first; empty when there is none.
    in property <string> prompt;
    // The confirming button waits for that word.
    in property <bool> locked;
    // The label of the second action; empty when there is none.
    in property <string> alternative;
    // The room at the top a control above the question keeps (the
    // Emergency control in a hidden session): the question never lies
    // under it.
    in property <length> top-reserved;
    // Called with true for the confirming button, false for Cancel or Escape.
    callback answered(confirmed: bool);
    // Called for the second action.
    callback alternative-chosen();
    // Called with what is in the field each time it changes.
    callback typed(text: string);

    accessible-role: groupbox;
    accessible-label: root.heading;
    accessible-description: root.body;

    // The widest label of the two buttons, measured as a button draws it,
    // against the half of the dialog each would get side by side.
    confirm-measure := Text {
        text: root.confirm-label;
        font-weight: Adw.weight-bold;
        visible: false;
        accessible-role: none;
    }
    cancel-measure := Text {
        text: "Cancel";
        font-weight: Adw.weight-bold;
        visible: false;
        accessible-role: none;
    }
    property <length> label-room: (sheet.width - 2 * 24px - 12px) / 2 - 2 * 20px;
    property <bool> stacked: max(confirm-measure.preferred-width, cancel-measure.preferred-width) > root.label-room;
    // Which of the two answers has the focus (0 neither, 1 Cancel, 2 the
    // confirming one), so that answers that flip between side by side and
    // stacked as the window is resized keep it where it was, and leave it
    // where it is outside them (on the Emergency control, armed or not).
    // Cancel takes it once, as the question opens without a field.
    property <int> answer-focus;
    property <bool> opened;
    // How much of the sentence lies outside its view, and about one line of
    // it.
    property <length> overflow: max(0px, body-view.content-height - body-view.height);
    property <length> line: Adw.font-size * 1.25;

    // Move the sentence's view `by` towards its end (back for less than
    // zero), no further than either end.
    function scroll-body(by: length) {
        body-view.content-y = max(-root.overflow, min(0px, body-view.content-y - by));
    }

    // The dimming over the window, and nothing underneath gets the pointer.
    Rectangle {
        background: Adw.dimming;
    }

    TouchArea { }

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.answered(false);
                return accept;
            }
            // A sentence longer than its view scrolls from the keyboard, as
            // the keys reach here from a button: a line, or a view less a
            // line.
            if (root.overflow > 0px) {
                if (event.text == Key.DownArrow) {
                    root.scroll-body(root.line);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.scroll-body(-root.line);
                    return accept;
                }
                if (event.text == Key.PageDown) {
                    root.scroll-body(body-view.height - root.line);
                    return accept;
                }
                if (event.text == Key.PageUp) {
                    root.scroll-body(root.line - body-view.height);
                    return accept;
                }
            }
            reject
        }

        sheet := Rectangle {
            width: min(root.width - 24px, 372px);
            // As tall as the question, up to the room the window leaves it,
            // and centred, but never under the room kept at the top.
            height: min(content.preferred-height, root.height - root.top-reserved - 24px);
            x: round((root.width - self.width) / 2px) * 1px;
            y: max(root.top-reserved + 12px, round((root.height - self.height) / 2px) * 1px);
            border-radius: Adw.alert-radius;
            background: Adw.dialog-bg;
            border-width: 1px;
            border-color: Adw.outline;

            content := VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 32px;
                padding-bottom: 24px;
                spacing: 10px;

                Text {
                    text: root.heading;
                    font-size: Adw.font-size-title;
                    font-weight: Adw.weight-title;
                    color: Adw.dialog-fg;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-role: none;
                }

                // The sentence, in a view of its own: the one part of the
                // question that gives up room when the window has too little.
                body-view := Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        Text {
                            text: root.body;
                            color: Adw.dialog-fg;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            accessible-role: none;
                        }
                    }
                }

                if root.prompt != "": WordEntry {
                    prompt: root.prompt;
                    edited(text) => {
                        root.typed(text);
                    }
                }

                if root.alternative == "" && !root.stacked: HorizontalLayout {
                    padding-top: 22px;
                    spacing: 12px;

                    Button {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        text: "Cancel";
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        // The field takes the focus itself when there is one.
                        init => {
                            if (root.prompt == "" && !root.opened) || root.answer-focus == 1 {
                                self.focus();
                                // A focus given here is the value the change
                                // below starts from, not a change.
                                root.answer-focus = 1;
                            }
                            root.opened = true;
                        }
                        changed has-focus => {
                            if (self.has-focus) {
                                root.answer-focus = 1;
                            } else if (root.answer-focus == 1) {
                                root.answer-focus = 0;
                            }
                        }
                        clicked => {
                            root.answered(false);
                        }
                    }

                    Button {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        text: root.confirm-label;
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        kind: root.destructive ? ButtonKind.destructive : ButtonKind.suggested;
                        enabled: !root.locked;
                        init => {
                            if (root.answer-focus == 2) {
                                self.focus();
                            }
                        }
                        changed has-focus => {
                            if (self.has-focus) {
                                root.answer-focus = 2;
                            } else if (root.answer-focus == 2) {
                                root.answer-focus = 0;
                            }
                        }
                        clicked => {
                            root.answered(true);
                        }
                    }
                }

                if root.alternative == "" && root.stacked: VerticalLayout {
                    padding-top: 22px;
                    spacing: 12px;

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: root.confirm-label;
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        kind: root.destructive ? ButtonKind.destructive : ButtonKind.suggested;
                        enabled: !root.locked;
                        init => {
                            if (root.answer-focus == 2) {
                                self.focus();
                            }
                        }
                        changed has-focus => {
                            if (self.has-focus) {
                                root.answer-focus = 2;
                            } else if (root.answer-focus == 2) {
                                root.answer-focus = 0;
                            }
                        }
                        clicked => {
                            root.answered(true);
                        }
                    }

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: "Cancel";
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        init => {
                            if (root.prompt == "" && !root.opened) || root.answer-focus == 1 {
                                self.focus();
                                // A focus given here is the value the change
                                // below starts from, not a change.
                                root.answer-focus = 1;
                            }
                            root.opened = true;
                        }
                        changed has-focus => {
                            if (self.has-focus) {
                                root.answer-focus = 1;
                            } else if (root.answer-focus == 1) {
                                root.answer-focus = 0;
                            }
                        }
                        clicked => {
                            root.answered(false);
                        }
                    }
                }

                if root.alternative != "": VerticalLayout {
                    padding-top: 22px;
                    spacing: 12px;

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: root.confirm-label;
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        kind: root.destructive ? ButtonKind.destructive : ButtonKind.suggested;
                        enabled: !root.locked;
                        clicked => {
                            root.answered(true);
                        }
                    }

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: root.alternative;
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        clicked => {
                            root.alternative-chosen();
                        }
                    }

                    Button {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        text: "Cancel";
                        shape: ButtonShape.response;
                        surface-fg: Adw.dialog-fg;
                        init => {
                            self.focus();
                        }
                        clicked => {
                            root.answered(false);
                        }
                    }
                }
            }

            // Where the view lies in a sentence longer than it, as the page
            // shows it. It takes no input.
            if root.overflow > 0px: Rectangle {
                property <length> track: body-view.height;
                property <length> thumb: max(24px, self.track * body-view.height / body-view.content-height);
                x: sheet.width - 14px;
                y: body-view.y + (self.track - self.thumb) * min(1, max(0, -body-view.content-y / root.overflow));
                width: 4px;
                height: self.thumb;
                border-radius: 2px;
                background: Adw.dialog-fg.with-alpha(0.3);
            }
        }
    }
}
