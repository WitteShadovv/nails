{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/status.schema.json",
  "title": "NAILS status --json",
  "description": "Machine-readable status envelope: one document with schema_version, command, ok, and either data (success) or error (pre-dispatch failure).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "status" },
    "ok": { "type": "boolean" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "state_source",
        "posture",
        "decoy_persistent",
        "decoy_writers",
        "overlays",
        "remaining_mounts",
        "overlay_verification",
        "hidden_root_mounted",
        "opsec_reminders"
      ],
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "inactive",
                "activating",
                "active",
                "deactivating",
                "degraded",
                "unknown"
              ]
            },
            "reason": { "type": "string", "minLength": 1 },
            "remaining_mounts": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "state_source": {
          "type": "string",
          "enum": ["loaded", "missing", "unreadable", "corrupt"]
        },
        "posture": {
          "type": "string",
          "enum": ["decoy", "active", "transitioning", "degraded", "inconsistent", "unknown"]
        },
        "decoy_persistent": {
          "description": "Whether the decoy keeps a persistent log/audit store (a persistent journald journal, or active rsyslog/syslog-ng/auditd) that a hidden session's metadata lands on. When true, an active posture is not fully secure.",
          "type": "boolean"
        },
        "remediation": { "type": "string", "minLength": 1 },
        "remaining_mounts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" }
        },
        "decoy_writers": {
          "description": "Processes that kept writing to the decoy after activation, recorded at activation time. Empty unless the hidden environment is active.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pid", "name", "targets", "kind"],
            "properties": {
              "pid": { "type": "integer", "minimum": 0 },
              "name": { "type": "string", "minLength": 1 },
              "service": { "type": "string", "minLength": 1 },
              "targets": {
                "type": "array",
                "items": { "type": "string", "pattern": "^/" }
              },
              "kind": {
                "type": "string",
                "enum": ["surviving", "stale_lower", "unverifiable"]
              }
            }
          }
        },
        "persona_mode": {
          "type": "string",
          "enum": ["shared-home", "fresh-home"]
        },
        "activated_at": { "type": "string", "format": "date-time" },
        "uptime_seconds": { "type": "integer", "minimum": 0 },
        "uptime_formatted": { "type": "string", "minLength": 1 },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mount_point", "status", "owned"],
            "properties": {
              "mount_point": { "type": "string", "pattern": "^/" },
              "status": {
                "type": "string",
                "enum": ["mounted", "not_mounted"]
              },
              "owned": { "type": "boolean" },
              "upperdir": { "type": "string", "pattern": "^/" }
            }
          }
        },
        "overlay_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["verified", "mismatch", "skipped", "not_applicable"]
            },
            "errors": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "hidden_toplevel": {
          "description": "Store path of the hidden NixOS system toplevel switched to on the last activation.",
          "type": "string",
          "minLength": 1
        },
        "hidden_config_warning": {
          "description": "Why the hidden NixOS configuration was not applied on the last activation; omitted when it is in force or none was requested.",
          "type": "string",
          "minLength": 1
        },
        "hidden_root_total_bytes": { "type": "integer", "minimum": 0 },
        "hidden_root_used_bytes": { "type": "integer", "minimum": 0 },
        "hidden_root_available_bytes": { "type": "integer", "minimum": 0 },
        "hidden_root_mounted": { "type": "boolean" },
        "activation_in_flight": {
          "description": "Present only while the state is activating: how long the activation has been running and, when the activation keeps a progress record on the hidden volume, the phase it is in.",
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "elapsed_seconds"],
          "properties": {
            "started_at": { "type": "string", "format": "date-time" },
            "elapsed_seconds": { "type": "integer", "minimum": 0 },
            "phase": { "type": "string", "minLength": 1 },
            "phase_label": { "type": "string", "minLength": 1 },
            "step": { "type": "integer", "minimum": 0 },
            "total_steps": { "type": "integer", "minimum": 1 },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "last_activation": {
          "description": "Timing of the most recent successful activation, kept across deactivation.",
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_ms", "finished_at"],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 0 },
            "finished_at": { "type": "string", "format": "date-time" }
          }
        },
        "undelivered_notifications": {
          "description": "Result notifications still queued on the hidden volume: neither pushed into the operator's session nor dispatched at login. Omitted when empty.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "created_at"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "created_at": { "type": "string", "minLength": 1 }
            }
          }
        },
        "notify_send_missing": {
          "description": "Present (true) when notify-send was missing in the operator's session when notifications were due.",
          "const": true
        },
        "opsec_reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "message"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["info", "warning", "critical"]
              },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        },
        "last_deactivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "generated_at",
            "status",
            "duration_ms",
            "outcome",
            "unmounted_overlays",
            "failed_overlays",
            "remaining_mounts",
            "findings"
          ],
          "properties": {
            "schema_version": { "type": "integer", "minimum": 1 },
            "generated_at": { "type": "string", "minLength": 1 },
            "status": {
              "type": "string",
              "enum": ["Secure", "Warning", "Critical"]
            },
            "duration_ms": { "type": "integer", "minimum": 0 },
            "outcome": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "final_state",
                "successful",
                "was_already_inactive",
                "reboot_recommended"
              ],
              "properties": {
                "final_state": { "type": "string", "minLength": 1 },
                "successful": { "type": "boolean" },
                "was_already_inactive": { "type": "boolean" },
                "reboot_recommended": { "type": "boolean" }
              }
            },
            "unmounted_overlays": {
              "type": "array",
              "items": { "type": "string" }
            },
            "failed_overlays": {
              "type": "array",
              "items": { "type": "string" }
            },
            "remaining_mounts": {
              "type": "array",
              "items": { "type": "string" }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["severity", "category", "message"],
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": ["Info", "Warn", "Critical"]
                  },
                  "category": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 },
                  "fix_guidance": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      }
    }
  }
}
