{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/status.schema.json",
  "title": "NAILS status --json",
  "description": "Machine-readable status envelope: one document with schema_version, command, ok, and either data (success) or error (failure). The posture comes from live facts (the mount table and the session plan in /run); state is the record on the hidden volume, reported next to it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "status" },
    "ok": { "type": "boolean" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posture": {
          "description": "The verdict: decoy, active (in the hidden root), transitioning (an entry is under way), degraded (an interrupted entry, or a hidden root without a way back) or unknown (the state record cannot be trusted).",
          "type": "string",
          "enum": ["decoy", "active", "transitioning", "degraded", "unknown"]
        },
        "session": {
          "description": "The live view the posture comes from.",
          "type": "string",
          "enum": ["decoy", "hidden", "entering", "interrupted", "hidden_without_plan"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["inactive", "active", "degraded", "unknown"]
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "state_source": {
          "type": "string",
          "enum": ["loaded", "missing", "unreadable", "corrupt"]
        },
        "entered_at": { "type": "string", "format": "date-time" },
        "uptime_seconds": { "type": "integer", "minimum": 0 },
        "uptime_formatted": { "type": "string", "minLength": 1 },
        "hidden_system": { "type": "string", "pattern": "^/" },
        "decoy_system": { "type": "string", "pattern": "^/" },
        "hidden_root": { "type": "string", "pattern": "^/" },
        "hidden_root_mounted": { "type": "boolean" },
        "accepted_decoy_storage": {
          "description": "Why the hidden root is not a volume of its own, when the session's activation accepted that with --allow-decoy-storage.",
          "type": "string",
          "minLength": 1
        },
        "hidden_root_covered_by": {
          "description": "The source of a filesystem mounted over the hidden volume, which now receives every file saved under the hidden root.",
          "type": "string",
          "minLength": 1
        },
        "policy_mounts": {
          "description": "The decoy filesystems the fstab policy placed in the hidden root.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "kind"],
            "properties": {
              "target": { "type": "string", "pattern": "^/" },
              "kind": { "type": "string", "enum": ["read-only", "overlay", "hidden-volume"] }
            }
          }
        },
        "masked_units": {
          "description": "The decoy units masked in the hidden root.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nextroot_mounted": { "type": "boolean" },
        "decoy_persistent": {
          "description": "Whether the decoy keeps a persistent log/audit store (a persistent journald journal, or active rsyslog/syslog-ng/auditd).",
          "type": "boolean"
        },
        "persona_mode": { "type": "string", "enum": ["shared-home", "fresh-home"] },
        "last_activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_ms", "finished_at"],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 0 },
            "finished_at": { "type": "string", "format": "date-time" }
          }
        },
        "opsec_reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "message"],
            "properties": {
              "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      }
    }
  }
}
