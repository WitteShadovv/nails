{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/init.schema.json",
  "title": "NAILS init --json",
  "description": "Machine-readable init envelope (contract version 2): one document with schema_version, command, ok, and either data (the layout written on the hidden volume and the next steps) or error. The envelope frame and error body are strict; the data is this command's own payload. ok is true only when the exit code is 0 or 9.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok"],
  "properties": {
    "schema_version": { "const": 2 },
    "command": { "const": "init" },
    "ok": { "type": "boolean" },
    "data": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "next"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "next": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["command"],
          "properties": { "command": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
