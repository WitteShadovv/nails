{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/deactivate.schema.json",
  "title": "NAILS deactivate --json",
  "description": "Machine-readable deactivate envelope (contract version 2), printed before the soft-reboot back to the decoy (or the power-off): one document with schema_version, command, ok, and either data or error. A declined prompt is the shared cancel shape: an error with the code `cancelled`, exit 130.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "ok"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "command": {
      "const": "deactivate"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "return_requested",
            "poweroff_requested"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "next"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["command"],
          "properties": { "command": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
