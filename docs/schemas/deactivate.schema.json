{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/deactivate.schema.json",
  "title": "NAILS deactivate --json",
  "description": "Machine-readable deactivate envelope, printed before the soft-reboot back to the decoy (or the power-off): one document with schema_version, command, ok, and either data or error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "ok"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "deactivate"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "return_requested",
            "poweroff_requested"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
