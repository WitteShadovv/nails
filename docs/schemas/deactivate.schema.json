{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/deactivate.schema.json",
  "title": "NAILS deactivate --json",
  "description": "Machine-readable deactivate envelope: one document with schema_version, command, ok, and either data (the reboot or power-off was requested) or error (the teardown failed).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "deactivate" },
    "ok": { "type": "boolean" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recovery_guidance"],
      "properties": {
        "status": { "enum": ["reboot_requested", "poweroff_requested"] },
        "recovery_guidance": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      }
    }
  }
}
