{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/verify.schema.json",
  "title": "NAILS verify --json",
  "description": "Machine-readable verify envelope: one document with schema_version, command, ok, and either data (a completed scan) or error (the scan could not run).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "verify" },
    "ok": { "type": "boolean" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findings",
        "scan_depth",
        "config_aware",
        "config_paths_checked",
        "checks_run",
        "areas_not_checked",
        "state_file_status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["secure", "warning", "critical"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "category", "message"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["info", "warn", "critical"]
              },
              "category": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "fix_guidance": { "type": "string", "minLength": 1 }
            }
          }
        },
        "scan_depth": {
          "type": "string",
          "enum": ["standard", "deep"]
        },
        "config_aware": { "type": "boolean" },
        "config_paths_checked": { "type": "integer", "minimum": 0 },
        "checks_run": { "type": "integer", "minimum": 0 },
        "areas_not_checked": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "state_file_status": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "const": "not_checked" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": { "const": "missing" },
                "path": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "state"],
              "properties": {
                "kind": { "const": "present" },
                "path": { "type": "string", "minLength": 1 },
                "state": {
                  "type": "string",
                  "enum": [
                    "inactive",
                    "activating",
                    "active",
                    "deactivating",
                    "degraded"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "message"],
              "properties": {
                "kind": { "const": "error" },
                "path": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      }
    }
  }
}
