{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/activate.schema.json",
  "title": "NAILS activate --json",
  "description": "Machine-readable activate envelope (contract version 2): exactly one document on stdout, printed before the soft-reboot (which ends the process). The version-1 progress line stream is gone; a window watches progress on its own channel. A success or a success with warnings carries data and is ok; a cancel is the shared cancel shape (an error with the code `cancelled`, no data); every other failure keeps its data with ok false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok"],
  "properties": {
    "schema_version": { "const": 2 },
    "command": { "const": "activate" },
    "ok": { "type": "boolean" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "duration", "filesystems", "masked_units", "message"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["entering", "entering_with_warnings", "already_active", "failed"]
        },
        "duration": { "type": "number", "minimum": 0 },
        "hidden_system": {
          "description": "The hidden NixOS toplevel entered, when one was built.",
          "type": "string",
          "minLength": 1
        },
        "filesystems": {
          "description": "What happens to each decoy filesystem in the hidden root (read-only, overlaid, masked).",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "masked_units": {
          "description": "The decoy units masked in the hidden root: swap, decoy filesystems it does not mount, and the boot-loader units.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "message": { "type": "string", "minLength": 1 },
        "failed_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "fix": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "next"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "next": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "A document that is not ok carries its error: a failure its own code, a cancel the code `cancelled`.",
      "if": { "required": ["ok"], "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"] }
    },
    {
      "description": "A failed activation is never ok.",
      "if": {
        "required": ["data"],
        "properties": {
          "data": { "required": ["status"], "properties": { "status": { "const": "failed" } } }
        }
      },
      "then": { "properties": { "ok": { "const": false } } }
    }
  ]
}
