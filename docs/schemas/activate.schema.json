{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nails.local/schemas/activate.schema.json",
  "title": "NAILS activate --json",
  "description": "A single line of the activate --json NDJSON stream. Each line is one document: zero or more progress events, then exactly one terminal line, which is either a result event (the entry was prepared, the session was already active, or preparing it failed) or a plain error envelope (a pre-dispatch failure such as a usage, config or state error). The result is printed before the soft-reboot, which ends the process.",
  "oneOf": [
    {
      "title": "progress event",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command",
        "type",
        "phase"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "command": {
          "const": "activate"
        },
        "type": {
          "const": "progress"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "title": "result event",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command",
        "type",
        "ok",
        "status",
        "duration",
        "filesystems",
        "masked_units",
        "message"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "command": {
          "const": "activate"
        },
        "type": {
          "const": "result"
        },
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "entering",
            "entering_with_warnings",
            "already_active",
            "error"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "hidden_system": {
          "description": "The hidden NixOS toplevel entered, when one was built.",
          "type": "string",
          "minLength": 1
        },
        "filesystems": {
          "description": "What happens to each decoy filesystem in the hidden root (read-only, overlaid, masked).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "masked_units": {
          "description": "Decoy units masked in the hidden root (swap, unmounted disks).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "failed_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "fix": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "title": "error envelope",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command",
        "ok",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "command": {
          "const": "activate"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
